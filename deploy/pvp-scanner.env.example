# PvP Scanner settings. Lives at /etc/pvp-scanner.env (root only, mode 600).
# After editing: sudo systemctl restart pvp-scanner

# Claude API key from https://console.anthropic.com -> API keys.
# Leave empty to run without AI review (keyword scoring only).
ANTHROPIC_API_KEY=

PVP_AI_MODEL=claude-opus-5-5
PVP_AI_EFFORT=medium
# Hard stop for AI spend per UTC day (estimated from token usage). Scans continue without AI after that.
PVP_AI_DAILY_BUDGET_USD=5

# Public abuse limits.
PVP_SCANS_PER_IP=6
PVP_COMPARES_PER_IP=20
PVP_RATE_WINDOW_SECONDS=600
PVP_MAX_CONCURRENT_SCANS=4

# The frontend is served from the same domain, so only that origin needs browser access.
PVP_ALLOWED_ORIGINS=https://{DOMAIN}
